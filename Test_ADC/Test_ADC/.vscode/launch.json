{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Debug (Live Watch)",
            "cwd": "${workspaceFolder}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/Test_ADC.elf"
                }
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": "4"
            }
        }
    ]
}
